# Neuron SDK 2.28.0 / 2.28.1: the last release where NxD Inference, vllm-neuron and NKI kernels support Trn1 and Inf2.
# Source of truth for every file in this directory. Values are the Neuron 2.28 release notes' package list and match
# `pip list` / `dpkg -l` on the 2.28 DLAMI (captured from a trn1.2xlarge on that DLAMI, Nov 2026).
NEURON_SDK=2.28
PYTHON=3.12

# pip (https://pip.repos.neuron.amazonaws.com + PyPI)
NEURONX_CC=2.23.6484.0+3b612583
TORCH_NEURONX=2.9.0.2.12.22436+0f1dac25
LIBNEURONXLA=2.2.15515.0+50c26cbd
NEURONX_DISTRIBUTED=0.17.26814+4b18de63
NEURONX_DISTRIBUTED_INFERENCE=0.8.16251+f3ca5575
NKI=0.2.0+g82fdb402
TORCH=2.9.0
TORCH_XLA=2.9.0
TORCHVISION=0.24.0
TRANSFORMERS=4.57.6
VLLM=0.13.0
VLLM_NEURON_REF=4fac6b7b922288325cf1d06ca3b1d990255230e2   # github.com/vllm-project/vllm-neuron branch release-0.4.1 (0.4.1)

# apt (https://apt.repos.neuron.amazonaws.com, jammy and noble)
AWS_NEURONX_DKMS=2.26.5.0
AWS_NEURONX_RUNTIME_LIB=2.30.51.0-faafe26f0
AWS_NEURONX_COLLECTIVES=2.30.59.0-f5cdefb39
AWS_NEURONX_TOOLS=2.28.23.0-f1c114a9d
AWS_NEURONX_OCI_HOOK=2.14.102.0

# DLAMI with all of the above preinstalled (venv /opt/aws_neuronx_venv_pytorch_inference_vllm_0_13).
# AWS deprecation date 2028-02-27 (still launchable by ID after that only if you copy it into your account).
DLAMI_NAME="Deep Learning AMI Neuron PyTorch Inference vLLM 0.13 (Ubuntu 24.04) 20260227"
DLAMI_US_EAST_1=ami-00c45d97f3070117d
DLAMI_US_EAST_2=ami-0cb3b3dd424204539
DLAMI_US_WEST_2=ami-0ad1f67eb7c2174d7
DLAMI_SA_EAST_1=ami-0e4aa8d0b4093c5cd
